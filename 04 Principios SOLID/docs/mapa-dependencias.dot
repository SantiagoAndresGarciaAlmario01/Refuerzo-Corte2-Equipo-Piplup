digraph capas {
graph [rankdir=TB, fontname="Helvetica", fontsize=20, nodesep=0.35, ranksep=0.9, labelloc=t, label=<<B>AquaPort Enterprise – mapa de dependencias entre capas</B><BR/><FONT POINT-SIZE="13" COLOR="#5A6B7F">Generado leyendo los imports de src/main/java · el número en cada flecha es la cantidad de imports</FONT>>];
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, penwidth=1.5];
edge [fontname="Helvetica", fontsize=11, color="#5A6B7F"];
subgraph cluster_infraestructura { label=<<B>Infraestructura (adaptadores y configuración)</B>>; style="rounded,filled"; fillcolor="#F4F0FF"; color="#5B4BB7"; fontcolor="#5B4BB7"; fontsize=16;
"infraestructura.api" [label=<api<BR/><FONT POINT-SIZE="10" COLOR="#7A5C00">usa com.fasterxml.jackson.annotation, com.fasterxml.jackson.core, com.fasterxml.jackson.databind, java.net.http</FONT>>, fillcolor="white", color="#5B4BB7"];
"infraestructura.configuracion" [label=<configuracion<BR/><FONT POINT-SIZE="10" COLOR="#7A5C00">usa com.fasterxml.jackson.databind, java.util.logging</FONT>>, fillcolor="white", color="#5B4BB7"];
"infraestructura.notificacion" [label=<notificacion<BR/><FONT POINT-SIZE="10" COLOR="#7A5C00">usa java.util.logging</FONT>>, fillcolor="white", color="#5B4BB7"];
"infraestructura.persistencia" [label=<persistencia>, fillcolor="white", color="#5B4BB7"];
"infraestructura.telemetria" [label=<telemetria>, fillcolor="white", color="#5B4BB7"];
}
subgraph cluster_aplicacion { label=<<B>Aplicación (casos de uso)</B>>; style="rounded,filled"; fillcolor="#E6F7FB"; color="#0E8FB8"; fontcolor="#0E8FB8"; fontsize=16;
"aplicacion.consulta" [label=<consulta>, fillcolor="white", color="#0E8FB8"];
"aplicacion.ejecucion" [label=<ejecucion>, fillcolor="white", color="#0E8FB8"];
"aplicacion.planificacion" [label=<planificacion>, fillcolor="white", color="#0E8FB8"];
}
subgraph cluster_dominio { label=<<B>Dominio (Java puro)</B>>; style="rounded,filled"; fillcolor="#FFF7E6"; color="#B4541A"; fontcolor="#B4541A"; fontsize=16;
"dominio.decorador" [label=<decorador<BR/><FONT POINT-SIZE="10" COLOR="#7A5C00">usa java.security</FONT>>, fillcolor="white", color="#B4541A"];
"dominio.evento" [label=<evento>, fillcolor="white", color="#B4541A"];
"dominio.fabrica" [label=<fabrica>, fillcolor="white", color="#B4541A"];
"dominio.modelo" [label=<modelo>, fillcolor="white", color="#B4541A"];
"dominio.puerto" [label=<puerto>, fillcolor="white", color="#B4541A"];
"dominio.validacion" [label=<validacion>, fillcolor="white", color="#B4541A"];
}
